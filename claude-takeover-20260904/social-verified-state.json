    },
    {
      "id": "verify-post",
      "label": "Find the post on the Map",
      "detail": "Return to the Map and confirm their own pin is there.",
      "reported": "cloud"
    },
    {
      "id": "view-post",
      "label": "Watch another tester’s post",
      "detail": "Dwell on an intercepting post in the Feed. A real view grows that post’s radius.",
      "reported": "production"
    },
    {
      "id": "like-post",
      "label": "Like it",
      "detail": "Like the post once per account. A real like grows its radius by about a kilometre.",
      "reported": "production"
    },
    {
      "id": "send-dm",
      "label": "Message the poster",
      "detail": "Open the Feed mailbox on the owner’s post and send a short note through Poplur Mail. One DM per poster, at most three per run; the thread is real and lands in that owner’s Mail.",
      "reported": "production"
    },
    {
      "id": "call-owner",
      "label": "Call the owner",
      "detail": "A paced voice or video call through Poplur Mail to the consenting owner; real WebRTC with a synthetic camera and microphone.",
      "reported": "production"
    },
    {
      "id": "idle",
      "label": "Pause between actions",
      "detail": "Human-paced dwell, then the cycle repeats. Each actor posts again every 20 minutes, up to four posts per run.",
      "reported": "cloud"
    }
